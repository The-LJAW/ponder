# Copy to .env for local dev (npm run dev). On Vercel, set these in
# Project Settings > Environment Variables.

# Required
ANTHROPIC_API_KEY=
SUPADATA_API_KEY=

# Optional: model for study packs. Haiku is cheapest (about 1 to 3 cents per
# video). claude-sonnet-5-5 writes sharper reflection questions at roughly
# twice the cost.
PONDER_MODEL=claude-haiku-4-5-20251001

# Optional: "native" (existing captions, cheapest) or "auto" (falls back to
# AI transcription for videos without captions, costs more per video).
SUPADATA_MODE=native

# Required in production: an Upstash Redis database (Vercel Marketplace >
# Upstash for Redis sets these for you). Powers the per-video cache and the
# usage limits. Without it the deployed API refuses to generate packs.
# (npm run dev uses an in-memory store, so you can leave these blank locally.)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Free packs per install per day (per IP is 3x this).
FREE_DAILY_LIMIT=5
# New packs per day across ALL users. The hard ceiling on spend: worst case
# is about this number x 6 cents per day on Haiku. Raise it as you grow.
GLOBAL_DAILY_LIMIT=200

# Only for private testing without Upstash. Never set this on a public deploy.
PONDER_ALLOW_NO_LIMITS=

# Set to 1 to return a sample pack without calling any API (UI work).
PONDER_MOCK=
