{
  "manifest_version": 3,
  "name": "Ponder: Study Any Video",
  "short_name": "Ponder",
  "version": "0.1.0",
  "description": "Turn a YouTube or Vimeo video into a study pack: summary, outline, flashcards, and reflection questions that make you think.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ponder this video",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://vimeo.com/*",
    "https://player.vimeo.com/*",
    "http://localhost:3000/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Open Ponder"
    }
  },
  "minimum_chrome_version": "116"
}
